# Copy to .env and fill in. Never commit .env — only this template is tracked.

# ── Supabase ──────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-side only, full DB admin — never VITE_

# ── Google (Gmail readonly + token refresh) ───────────────────────────────
# The OAuth client used for sign-in is configured in the Supabase dashboard,
# not here. These two are used by api/refresh-google-token.ts.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Gemini (server-side classifier) ───────────────────────────────────────
GEMINI_API_KEY=                     # never VITE_ — that would ship it to the browser

# ── Razorpay ──────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_MONTHLY=              # Razorpay subscription plan id, monthly
RAZORPAY_PLAN_ANNUAL=               # Razorpay subscription plan id, annual
VITE_RAZORPAY_KEY_ID=               # same value as RAZORPAY_KEY_ID, used client-side

# ── App ───────────────────────────────────────────────────────────────────
ALLOWED_ORIGIN=                     # production origin; comma-separated allows a domain move
VITE_OWNER_EMAILS=                  # comma-separated; unlimited scans, premium bypass
CRON_SECRET=                        # guards /api/cleanup-scan-rejections

# ── Error reporting (optional) ────────────────────────────────────────────
VITE_SENTRY_DSN=                    # browser; read at BUILD time, unset = SDK not bundled
SENTRY_DSN=                         # serverless; keep it a SEPARATE Sentry project
