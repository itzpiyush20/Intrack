{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "lib": ["ES2020", "DOM"],
    "types": ["node", "vite/client"],
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": true,
    "outDir": ".vercel/output/functions",
    "rootDir": ".",
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "api/**/*.ts",
    "src/constants/pricing.ts",
    "src/services/emailScanner.ts",
    "src/services/emailBoilerplate.ts",
    "src/services/emailScanGates.ts",
    "src/services/aiService.ts",
    "src/services/learningEngine.ts",
    "src/services/googleAuth.ts",
    "src/services/supabase.ts",
    "src/services/merchantNormalizer.ts",
    "src/services/paymentMerge.ts",
    "src/services/currency.ts",
    "src/services/subscription.ts",
    "src/utils/index.ts",
    "src/utils/crypto.ts",
    "src/utils/dateFilter.ts",
    "src/utils/transactionIdentity.ts",
    "src/utils/creditCardBill.ts",
    "src/types/database.ts"
  ]
}
